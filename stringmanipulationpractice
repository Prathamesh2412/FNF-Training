        private List<Employee> employee = new List<Employee>();

        public void Add()
        {
            Employee emp = new Employee();
            Console.WriteLine("Enter the id of the book");
            emp.Empid = int.Parse(Console.ReadLine());

            Console.WriteLine("Enter the name of the book");
            emp.EmpName = Console.ReadLine();

            Console.WriteLine("Enter the description of the book");
            emp.description = Console.ReadLine();

            employee.Add(emp);
            Console.WriteLine("employee added sucess fully");

        }

        public void delete()
        {
            Console.WriteLine("enter the emp id to delete");
            int empid = int.Parse(Console.ReadLine());

            var existing = employee.Find(e => e.Empid == empid);
            if (existing != null)
            {
                employee.Remove(existing);
                Console.WriteLine("employee deleted ");
            }
            Console.WriteLine("employee not found");
        }

        public void update()
        {
            Employee emp = new Employee();

            Console.WriteLine("enter the emp id to update");
            int empid = int.Parse(Console.ReadLine());
            var existing = employee.FirstOrDefault(e => e.Empid == empid);
            if (existing != null)
            {
                Console.WriteLine("enter the emp Name");
                emp.EmpName = Console.ReadLine();
                Console.WriteLine("enter the emp Desc");
                emp.description = Console.ReadLine();
                Console.WriteLine("emp updated");
            }
            Console.WriteLine("emp not found");
        }
        public void find()
        {           
            Console.WriteLine("enter emp id");
            int empid = int.Parse(Console.ReadLine());
            Employee emp = employee.FirstOrDefault(e => e.Empid == empid);
            Console.WriteLine($"ID: {emp.Empid}\n, Title: {emp.EmpName}\n, Author: {emp.description}");
        }
